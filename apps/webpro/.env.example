# ─── WEBPRO AGENCY — variables d'environnement ───────────────────────────
# Copier ce fichier en .env.local (développement) ou les définir chez l'hébergeur (production).
# Ne jamais commiter de vraie clé.

# URL publique du site, sans barre finale. Obligatoire en production :
# elle sert aux canonical, au sitemap, au robots.txt, à l'Open Graph et aux données structurées.
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Envoi du formulaire de contact via Resend (https://resend.com).
# Sans ces deux variables, le formulaire l'indique honnêtement et propose l'envoi par messagerie.
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend, ex. : WEBPRO AGENCY <contact@votre-domaine.fr>
CONTACT_FROM_EMAIL=
# Destinataire des demandes (par défaut : webproagency25@gmail.com)
CONTACT_TO_EMAIL=webproagency25@gmail.com

# Optionnel : copie de chaque demande (contact, maquette gratuite) envoyée en JSON à cette adresse
# (tableur, CRM, outil d'automatisation type Make / Zapier / n8n). Fonctionne seul ou en plus de Resend.
LEADS_WEBHOOK_URL=
