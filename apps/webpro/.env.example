# ─── WEBPRO AGENCY — variables d'environnement ───────────────────────────
# Copier ce fichier en .env.local (développement) ou les définir chez l'hébergeur (Vercel → Settings → Environment Variables).
# Ne jamais commiter de vraie clé. Aucune de ces valeurs n'est envoyée au navigateur, sauf celles préfixées NEXT_PUBLIC_.

# URL publique du site, sans barre finale. Tant qu'elle n'est pas définie, le site reste volontairement NON INDEXABLE
# (robots.txt + noindex). Elle sert aussi aux canonical, au sitemap, à l'Open Graph et aux données structurées.
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# ─── Envoi des formulaires (contact + maquette gratuite) via Resend — https://resend.com ───
# Clé API Resend (secrète). Sans elle, aucun email n'est envoyé et le formulaire l'indique au visiteur.
RESEND_API_KEY=
# Destinataire des demandes.
CONTACT_TO_EMAIL=webproagency25@gmail.com
# Expéditeur. Laisser vide pour utiliser l'adresse de test de Resend (onboarding@resend.dev), qui ne peut écrire
# QU'À l'adresse du compte Resend : créer le compte Resend avec webproagency25@gmail.com.
# Avec un domaine vérifié dans Resend : WEBPRO AGENCY <contact@votre-domaine.fr>
CONTACT_FROM_EMAIL=
# Accusé de réception automatique au prospect ("true" / vide). Nécessite un expéditeur sur domaine vérifié.
CONTACT_AUTOREPLY=

# ─── Vérification des outils Google / Bing (code de la balise meta, facultatif) ───
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
